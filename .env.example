# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. Copy the pooled connection string; it must include
# `?sslmode=require`. A separate database from OttoLabs.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (type: Web application). The OttoLabs client works:
# just add these redirect URIs to it.
#   dev:  http://localhost:3100/api/auth/callback/google
#   prod: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# The Google addresses allowed to sign in, comma-separated. Nobody else can.
ALLOWED_EMAILS="you@example.com,friend@example.com"

# ── Links ───────────────────────────────────────────────────────────────────
# Where the "OttoLabs" link in the sidebar goes.
NEXT_PUBLIC_OTTOLABS_URL="https://your-ottolabs-domain"

# ── AI essay feedback ───────────────────────────────────────────────────────
# OpenAI-compatible endpoint. Server-only: never prefix these with NEXT_PUBLIC_.
AI_API_KEY=""
# Optional overrides. Models are tried in order until one answers.
AI_BASE_URL="https://api.cosmoshub.tech/v1"
AI_MODELS="deepseek-v4-pro,gpt-6-sol,claude-opus-4.8,glm-5.2"
